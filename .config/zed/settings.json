// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_ui_font_size": 17.0,
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "JetBrains",
  "ui_font_size": 18.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "Carbonfox - blurred",
    "dark": "Carbonfox - blurred"
  },

  "experimental.theme_overrides": {
      "terminal.ansi.black": "#bcc0cc",
      "terminal.ansi.bright_black": "#acb0be",
      "terminal.ansi.red": "#8CE1F9",
      "terminal.ansi.green": "#79CAFD",
      "terminal.ansi.yellow": "#6BB2ED",
      "terminal.ansi.blue": "#6BA8ED",
      "terminal.ansi.magenta": "#6BA1ED",
      "terminal.ansi.cyan": "#6B87ED",
      "terminal.ansi.white": "#5c5f77",
    },

  "terminal": {
    "font_size": 14.0,
    "font_family": ".ZedMono",
    "scroll_multiplier": 1.5,
    "scrollbar": {
      "show": "auto"
    },
    "toolbar": {
      "breadcrumbs": false
    },
    "max_scroll_history_lines": 50000,
    "default_width": 640.0,
    "default_height": 450.0,
    "minimum_contrast": 0.0,
    "shell": {
      "program": "/bin/zsh"
    }
  }
}
