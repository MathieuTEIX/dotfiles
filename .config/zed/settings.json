// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_ui_font_size": 16.0,
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "base_keymap": "JetBrains",
  "ui_font_size": 16.0,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Carbonfox - blurred",
    "dark": "Carbonfox - blurred"
  },

  "experimental.theme_overrides": {
      "terminal.ansi.black": "#202020",
      "terminal.ansi.bright_black": "#808080",
      "terminal.ansi.dim_black": "#202020",
      "terminal.ansi.red": "#FF6600",
      "terminal.ansi.bright_red": "#FF6600",
      "terminal.ansi.dim_red": "#FF660088",
      "terminal.ansi.green": "#FF4D00",
      "terminal.ansi.bright_green": "#FF4D00",
      "terminal.ansi.dim_green": "#FF4D00",
      "terminal.ansi.yellow": "#FF0000",
      "terminal.ansi.bright_yellow": "#FF0000",
      "terminal.ansi.dim_yellow": "#FF0000",
      "terminal.ansi.blue": "#FF0457",
      "terminal.ansi.bright_blue": "#FF0457",
      "terminal.ansi.dim_blue": "#FF0457",
      "terminal.ansi.magenta": "#E2036F",
      "terminal.ansi.bright_magenta": "#E2036F",
      "terminal.ansi.dim_magenta": "#E2036F",
      "terminal.ansi.cyan": "#FF058A",
      "terminal.ansi.bright_cyan": "#FF058A",
      "terminal.ansi.dim_cyan": "#FF058A",
      "terminal.ansi.white": "#d8d8d8",
      "terminal.ansi.bright_white": "#d8d8d8",
      "terminal.ansi.dim_white": "#d8d8d8"
    },

  "terminal": {
    "font_size": 14.0,
    "font_family": ".ZedMono",
    "scroll_multiplier": 1.5,
    "scrollbar": {
      "show": "auto"
    },
    "toolbar": {
      "breadcrumbs": false
    },
    "max_scroll_history_lines": 50000,
    "default_width": 640.0,
    "default_height": 450.0,
    "minimum_contrast": 0.0,
    "shell": {
      "program": "/bin/zsh"
    }
  }
}
